{
  "name": "ping",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/ping/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release",
        "cwd": "services/ping"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run",
        "cwd": "services/ping"
      }
    }
  }
}
